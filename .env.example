# Copy this file to .env for local development (never commit .env)

# PostgreSQL connection string — Railway provides this automatically as DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/omxsscreener

# Any random secret string (used for session signing)
SESSION_SECRET=change-me-to-a-long-random-string

# Port to listen on — Railway provides this automatically
PORT=8080

# Set to "production" when deploying
NODE_ENV=production
